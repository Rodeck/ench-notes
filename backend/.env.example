# Public base URL of this API (behind Caddy)
PUBLIC_URL=https://ench-api.duckdns.org

# Comma-separated origins allowed to call /api/* (the frontend)
FRONTEND_ORIGINS=http://localhost:5173

# Anthropic API key for premium tag suggestions
ANTHROPIC_API_KEY=

# Firebase Admin credentials: path to service account JSON
# (in Docker this is mounted at /secrets/service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Firebase *web* config — used by the OAuth consent page so the user can
# sign in with Google in the browser. Same values as the frontend's.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=

PORT=8787
