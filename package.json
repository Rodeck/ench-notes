{
  "name": "ench-notes",
  "private": true,
  "description": "Root scripts for the local dev stack and tests. No install needed here; frontend/ and backend/ have their own dependencies.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "seed": "node scripts/dev.mjs --seed-only",
    "test": "firebase emulators:exec --only auth,firestore \"node scripts/run-tests.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore \"node frontend/tests/firestore-rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore \"node scripts/run-tests.mjs --e2e\""
  }
}
